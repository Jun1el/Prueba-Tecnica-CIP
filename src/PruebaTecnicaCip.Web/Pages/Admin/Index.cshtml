@page
@model PruebaTecnicaCip.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Dashboard administrador";
}

<div class="d-flex align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Dashboard administrador</h1>
        <p class="text-muted mb-0">@Model.Metrics.EventName</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-@Model.StatusType" role="alert">
        @Model.StatusMessage
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="border rounded p-3 h-100">
            <div class="text-muted small">Cupo total</div>
            <div class="fs-3 fw-semibold">@Model.Metrics.Capacity</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="border rounded p-3 h-100">
            <div class="text-muted small">Aprobados</div>
            <div class="fs-3 fw-semibold">@Model.Metrics.ApprovedCount</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="border rounded p-3 h-100">
            <div class="text-muted small">Disponibles</div>
            <div class="fs-3 fw-semibold">@Model.Metrics.RemainingCapacity</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="border rounded p-3 h-100">
            <div class="text-muted small">Pendientes</div>
            <div class="fs-3 fw-semibold">@Model.Metrics.PendingCount</div>
        </div>
    </div>
</div>

<div class="d-flex align-items-center justify-content-between mb-2">
    <h2 class="h5 mb-0">Solicitudes pendientes</h2>
    <span class="text-muted small">@Model.Metrics.RejectedCount rechazadas</span>
</div>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>DNI</th>
                <th>Nombre</th>
                <th>Consejo</th>
                <th>Fecha</th>
                <th>DNI menor</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var request in Model.PendingRegistrations)
            {
                <tr>
                    <td>@request.Dni</td>
                    <td>@request.FullName</td>
                    <td>@request.Council</td>
                    <td>@request.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td><a href="@request.ChildDniImagePath" target="_blank" rel="noopener">Ver imagen</a></td>
                    <td>
                        <form method="post" asp-page-handler="Approve" class="mb-2">
                            <input type="hidden" name="id" value="@request.Id" />
                            <button class="btn btn-sm btn-success" type="submit">Aprobar</button>
                        </form>
                        <form method="post" asp-page-handler="Reject" class="d-flex gap-2">
                            <input type="hidden" name="id" value="@request.Id" />
                            <input class="form-control form-control-sm" name="observation" placeholder="Observacion" maxlength="500" required />
                            <button class="btn btn-sm btn-outline-danger" type="submit">Rechazar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.PendingRegistrations.Count == 0)
{
    <p class="text-muted">No hay solicitudes pendientes.</p>
}
