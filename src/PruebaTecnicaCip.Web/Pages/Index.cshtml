@page
@model IndexModel
@{
    ViewData["Title"] = "Inscripcion Dia del Padre";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-xl-6">
        <div class="mb-4">
            <h1 class="h2">Inscripcion Dia del Padre</h1>
            <p class="text-muted mb-0">Registra tus datos para validar la solicitud de participacion.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="alert alert-@Model.StatusType" role="alert">
                @Model.StatusMessage
            </div>
        }

        @if (Model.IsFull)
        {
            <div class="alert alert-warning" role="alert">
                El aforo del evento esta completo. No se aceptan nuevas inscripciones.
            </div>
        }

        <form method="post" enctype="multipart/form-data" class="vstack gap-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div>
                <label asp-for="Input.Dni" class="form-label">DNI del colegiado</label>
                <input asp-for="Input.Dni" class="form-control" inputmode="numeric" autocomplete="off" maxlength="8" />
                <span asp-validation-for="Input.Dni" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Input.FullName" class="form-label">Nombre completo</label>
                <input asp-for="Input.FullName" class="form-control" autocomplete="name" maxlength="160" />
                <span asp-validation-for="Input.FullName" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="Input.ChildDniImage" class="form-label">Imagen del DNI del menor</label>
                <input asp-for="Input.ChildDniImage" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                <span asp-validation-for="Input.ChildDniImage" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary" disabled="@Model.IsFull">Enviar solicitud</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
